{
  "name": "@horizon-examples/express-server",
  "version": "2.0.0",
  "description": "Example of a Horizon server within an Express server with TypeScript",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "nodemon --watch src --ext ts --exec ts-node src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "author": "RethinkDB",
  "license": "MIT",
  "dependencies": {
    "@horizon/server": "^2.0.0",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rethinkdb/horizon.git"
  }
}
